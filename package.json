{
  "name": "gh-kameleon",
  "version": "1.0.0",
  "description": "A chameleon that eats your GitHub contribution graph and turns the colour of what it eats",
  "type": "module",
  "private": true,
  "bin": { "gh-kameleon": "src/cli.ts" },
  "scripts": {
    "build": "bun src/cli.ts --username Kameleon21 --output kameleon.svg",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": { "@types/bun": "latest", "typescript": "^5" }
}
